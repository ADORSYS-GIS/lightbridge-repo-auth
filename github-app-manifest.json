{
  "name": "vymalo-opencode",
  "description": "Binds your GitHub org to your Vymalo account so CI runners can use AI coding via OIDC, and posts AI code reviews as this bot.",
  "url": "https://vymalo.com",
  "public": true,
  "hook_attributes": {
    "url": "https://repo-auth.ai.camer.digital/github/webhooks",
    "active": true
  },
  "redirect_url": "https://app.vymalo.com/github/setup",
  "setup_url": "https://app.vymalo.com/github/installed",
  "setup_on_update": true,
  "default_permissions": {
    "metadata": "read",
    "issues": "write",
    "pull_requests": "write"
  },
  "default_events": [
    "installation",
    "installation_repositories"
  ]
}

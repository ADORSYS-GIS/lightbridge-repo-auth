# Copy to .env for local dev (dotenvy loads it). Never commit real secrets.
RA__SERVER__BIND=0.0.0.0:3000
RA__DATABASE__URL=postgres://repoauth:repoauth@localhost:5432/repoauth
RA__GITHUB__APP_ID=000000
RA__GITHUB__WEBHOOK_SECRET=dev-webhook-secret
RA__GITHUB__PRIVATE_KEY_PATH=./config/app-private-key.pem
# Shared secret Authorino must send on /v1/resolve (X-Internal-Token).
RA__RESOLVE__INTERNAL_TOKEN=dev-internal-token
# Base URL embedded in each Source audience: <BASE>/sources/<source_id>
RA__SOURCE__AUDIENCE_BASE=https://api.vymalo.com
RUST_LOG=info,lightbridge_repo_auth=debug
